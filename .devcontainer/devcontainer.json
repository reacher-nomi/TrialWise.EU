   {
     // STAGE environment: open the repo in GitHub Codespaces.
     // "universal" = GitHub's default image. It already has Docker, Python and Node.
     "name": "TrialWise (Stage)",
     "image": "mcr.microsoft.com/devcontainers/universal:2",
     "postCreateCommand": "cp -n .env.example .env || true",
     "postStartCommand": "APP_ENV=stage docker compose up -d --build",
     "forwardPorts": [5173, 8000],
     "portsAttributes": {
       "5173": { "label": "Frontend" },
       "8000": { "label": "API (docs at /docs)" }
     }
   }